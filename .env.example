# Copy to .env.local and fill in. See README.md → "Setup" for where each value comes from.

# Clerk — https://dashboard.clerk.com
# Google sign-in must use *custom credentials* with the Calendar scopes (see README).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/calendar
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/calendar

# Neon Postgres — https://console.neon.tech (use the pooled connection string)
DATABASE_URL=

# Gemini — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional. Any Gemini model ID; defaults to the latest Flash model.
GEMINI_MODEL=gemini-flash-latest
