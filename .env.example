# Copy to .env (or .env.local) and fill in. See README.md → "Setup".

# Google OAuth — Google Cloud → Google Auth Platform → Clients → "Web application".
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs session JWTs and encrypts stored Google tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional. Public URL of the app; the OAuth redirect URI is built from it. Defaults to the request origin.
APP_URL=http://localhost:3000

# Neon Postgres — https://console.neon.tech (use the pooled connection string)
DATABASE_URL=

# Gemini — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional. Any Gemini model ID; defaults to the latest Flash model.
GEMINI_MODEL=gemini-flash-latest
